# Public phone access: set this when the app is behind HTTPS.
PANEL_REQUIRE_PAIRING=1

# Optional ports and identity.
PANEL_API_PORT=8787
PANEL_AGENT_NAME=My Coding Agent

# Optional remote Bridge settings.
# PANEL_BRIDGE_HOST=127.0.0.1
# PANEL_BRIDGE_PORT=8788
# PANEL_BRIDGE_TOKEN=replace-with-a-long-random-token

# Optional local Whisper settings.
# PANEL_WHISPER_BIN=whisper
# PANEL_WHISPER_MODEL=small
# PANEL_WHISPER_TIMEOUT_MS=180000
