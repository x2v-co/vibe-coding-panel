FROM node:24-alpine AS build
ARG VERSION=unknown
ENV PANEL_BUILD_REVISION=$VERSION
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html tsconfig*.json vite.config.ts ./
COPY src ./src
COPY public ./public
COPY server ./server
RUN npm run build

FROM node:24-alpine
ARG VERSION=development
LABEL org.opencontainers.image.revision=$VERSION
ENV NODE_ENV=production PANEL_VERSION=$VERSION
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server
EXPOSE 8789
USER node
CMD ["npm", "run", "relay"]
