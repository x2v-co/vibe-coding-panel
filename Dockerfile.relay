FROM node:24-alpine AS build
ARG VERSION=unknown
ENV PANEL_BUILD_REVISION=$VERSION
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY index.html tsconfig*.json vite.config.ts VERSION ./
COPY src ./src
COPY public ./public
COPY server ./server
COPY scripts/sync-controller-styles.mjs ./scripts/sync-controller-styles.mjs
COPY scripts/release-plugin.mjs scripts/release-plugin.d.mts ./scripts/
RUN npm run build

FROM node:24-alpine
ARG VERSION=development
LABEL org.opencontainers.image.revision=$VERSION
ENV NODE_ENV=production PANEL_VERSION=$VERSION
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server
# Mount point for the metrics volume; a fresh named volume inherits this owner.
RUN mkdir -p /data/metrics && chown node:node /data/metrics
EXPOSE 8789
USER node
CMD ["npm", "run", "relay"]
