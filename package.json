{
  "name": "vibe-coding-panel",
  "version": "0.1.0",
  "description": "A computer workspace for local coding agents with a companion phone remote.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x2v-co/vibe-coding-panel.git"
  },
  "homepage": "https://github.com/x2v-co/vibe-coding-panel#readme",
  "bugs": "https://github.com/x2v-co/vibe-coding-panel/issues",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "node scripts/sync-controller-styles.mjs && npm run check && vite build",
    "start": "node server/index.js",
    "connect": "node scripts/launch.mjs",
    "connect:relay": "node scripts/connect-relay.mjs",
    "relay": "node server/relay.js",
    "share": "node scripts/share.mjs",
    "check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test server/*.test.js",
    "doctor": "node scripts/launch.mjs --doctor",
    "test:acceptance": "node --test scripts/acceptance.test.mjs",
    "controller": "node scripts/controller.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cross-spawn": "^7.0.6",
    "express": "latest",
    "lucide-react": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
